# ServiceIQ — local development environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Required by backend/db/connection.py
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test
DB_USER=aja
# DB_PASSWORD is optional if the PostgreSQL user has no password (local dev)
DB_PASSWORD=

# Optional pool size tuning
# DB_MIN_CONNECTIONS=2
# DB_MAX_CONNECTIONS=10

# ── ServiceIQ Backend Auth Token ──────────────────────────────────────────────
# Stub base64url JWT token used by Langflow tools to authenticate to the backend.
# Format: base64url({"user_id":1,"role":"manager","lab_scope":[1,2,...,24]})
# For local dev, generate with:
#   python3 -c "import base64,json; d={'user_id':1,'role':'manager','lab_scope':list(range(1,25))}; print(base64.urlsafe_b64encode(json.dumps(d).encode()).rstrip(b'=').decode())"
# IMPORTANT: In production, replace with a real JWT signed by your auth service.
# See: backend/api/app.py _decode_token() — STUB IMPLEMENTATION
SERVICEIQ_BEARER_TOKEN=eyJ1c2VyX2lkIjogMSwgInJvbGUiOiAibWFuYWdlciIsICJsYWJfc2NvcGUiOiBbMSwgMiwgMywgNCwgNSwgNiwgNywgOCwgOSwgMTAsIDExLCAxMiwgMTMsIDE0LCAxNSwgMTYsIDE3LCAxOCwgMTksIDIwLCAyMSwgMjIsIDIzLCAyNF19

# ── Google Generative AI ───────────────────────────────────────────────────────
# Required if running the Gemini agent directly (not via Langflow global variable)
# Obtain from: https://ai.google.dev/
# GOOGLE_API_KEY=your-google-api-key-here

# ── Langflow ──────────────────────────────────────────────────────────────────
# Langflow runs at http://localhost:7860 by default (managed separately)
# The following are stored as Langflow global variables, not env vars:
#   GOOGLE_API_KEY      → set in Langflow UI → Global Variables
#   SERVICEIQ_BEARER_TOKEN → set in Langflow UI → Global Variables (type: Credential)
#
# Langflow API key for /api/v1/run:
#   sk-ryhzLF-hhKDu23hrKwa_hZ0T0UtjlRdu7m6yUrfXEaM
#   (set in Langflow UI → Settings → API Keys)
